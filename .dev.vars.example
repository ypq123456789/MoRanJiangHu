# Copy to .dev.vars for local Wrangler development.
# Do not commit .dev.vars.

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_BACKUP_CLIENT_ID=
GITHUB_BACKUP_CLIENT_SECRET=
GITHUB_NATIVE_CLIENT_ID=
GITHUB_NATIVE_CLIENT_SECRET=
FANDOM_PRESET_GITHUB_TOKEN=
IMAGE_HOST_TOKEN=
MORAN_B2_DISTRIBUTION_TOKEN=
MORAN_OPENLIST_AUTH_TOKEN=

FANDOM_PRESET_REPO_OWNER=
FANDOM_PRESET_REPO_NAME=
FANDOM_PRESET_BASE_BRANCH=main
MORAN_B2_DISTRIBUTION_BASE_URL=https://f004.backblazeb2.com/file/bacon111
MORAN_B2_DISTRIBUTION_RELEASE_PREFIX=moranjianghu
MORAN_OPENLIST_API_BASE_URL=http://159.138.7.126:5244
MORAN_OPENLIST_DIRECT_BASE_URL=http://159.138.7.126:5244

# 发版通知方式一：频道 Webhook（需要频道里的「管理 Webhook」权限）
# 频道设置 → 整合 → Webhook → 新 Webhook → 复制 Webhook 网址
DISCORD_WEBHOOK_URL=

# 发版通知方式二：机器人（频道不是自己的时，请管理员邀请机器人并授予「查看频道 + 发送消息」）
# DISCORD_BOT_TOKEN=
# DISCORD_CHANNEL_ID=

# 可选：正文里 @ 的身份组/用户，例如 <@&1234567890>
DISCORD_MENTION=
# 可选：访问 Discord 走的代理，例如 http://127.0.0.1:7890（仅直连失败时使用）
DISCORD_PROXY=
